; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deckhand"
config/tags=PackedStringArray("experiment")
run/main_scene="res://scenes/game/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/project_settings_override="user://window.cfg"
run/max_fps=60
run/low_processor_mode=true

[audio]

general/default_playback_type.web=0
driver/output_latency.web=150

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="result.avi"

[gui]

timers/tooltip_delay_sec=0.3

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
