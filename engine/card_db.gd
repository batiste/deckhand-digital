class_name CardDB
extends RefCounted
## Static card definitions loaded from data/cards.json (generated by tools/build_cards.js).

const DATA_PATH := "res://data/cards.json"
## The banners printed on each Infamy card, left to right (tools/infamy_banners.gd).
const PRINTED_BANNERS_PATH := "res://data/infamy_banners.json"

const RESOURCES: Array[String] = ["g", "p", "r", "h", "s", "e", "c", "cs"]
const BANNERS: Array[String] = ["basic", "gun", "parrot", "rum", "helm", "skull", "crown", "coin"]

const RESOURCE_NAMES := {
	"g": "Gun", "p": "Parrot", "r": "Rum", "h": "Helm",
	"s": "Skull", "e": "Emerald", "c": "Gold coin", "cs": "Silver coin",
}
const BANNER_NAMES := {
	"basic": "Pearl", "gun": "Gun", "parrot": "Parrot", "rum": "Rum",
	"helm": "Helm", "skull": "Skull", "crown": "Crown", "coin": "Hand",
}

static var _cards: Array[Dictionary] = []
static var _printed := {}

static func ensure_loaded() -> void:
	if not _cards.is_empty():
		return
	var text := FileAccess.get_file_as_string(DATA_PATH)
	var parsed: Variant = JSON.parse_string(text)
	if not parsed is Array:
		push_error("CardDB: could not parse %s" % DATA_PATH)
		return
	for raw: Dictionary in parsed:
		_cards.append(_normalize(raw))

static func _normalize(raw: Dictionary) -> Dictionary:
	# JSON numbers come back as floats; the engine works with ints.
	var card := raw.duplicate(true)
	for key in ["id", "vp", "tentacles", "battles", "hooks", "compasses"]:
		card[key] = int(card[key])
	if card.multiplier != null:
		card.multiplier.vp = int(card.multiplier.vp)
	return card

static func get_card(id: int) -> Dictionary:
	ensure_loaded()
	return _cards[id - 1]

static func ids_of_kind(kind: String) -> Array[int]:
	ensure_loaded()
	var out: Array[int] = []
	for card in _cards:
		if card.kind == kind:
			out.append(card.id)
	return out

## The banners an Infamy card asks for, in the order they are printed on it.
static func printed_banners(id: int) -> Array:
	if _printed.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(PRINTED_BANNERS_PATH))
		_printed = parsed if parsed is Dictionary else {"": []}
	return _printed.get(str(id), get_card(id).cost)

static func is_infamy(id: int) -> bool:
	return get_card(id).kind == "infamy"

static func title(id: int) -> String:
	return get_card(id).title

## Every resource a card can produce when discarded and revealed.
static func production_tokens(id: int) -> Array[String]:
	var out: Array[String] = []
	for slot: Array in get_card(id).production:
		for token: String in slot:
			if not out.has(token):
				out.append(token)
	return out
