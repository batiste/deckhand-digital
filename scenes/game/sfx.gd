class_name Sfx
extends Node
## Sound effects (generated by tools/make_sfx.py). Sounds never start together:
## each one waits for a short gap after the previous, a sound already waiting
## is not queued twice, and minor sounds that would start too late are dropped.

const DIR := "res://assets/sfx/"
const NAMES: Array[String] = [
	"card_flip", "card_deal", "card_place", "coin", "bell", "reveal", "claim",
	"battle", "hook", "telescope", "pass", "click", "victory", "defeat",
]
## Cues that matter to the game; they are delayed but never dropped.
const IMPORTANT: Array[String] = ["bell", "reveal", "claim", "battle", "hook", "telescope", "victory", "defeat"]
const VOICES := 10
const GAP := 0.13
const MAX_LAG := 0.35

var enabled := true

var _streams := {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _free_at := 0.0 # time (s) when the next sound may start
var _waiting := {} # sound name -> true while scheduled but not started

func _ready() -> void:
	for sound in NAMES:
		_streams[sound] = load(DIR + sound + ".wav")
	for _i in range(VOICES):
		var player := AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)

## Plays `sound`; `volume_db` lowers it (e.g. for opponents' actions).
func play(sound: String, volume_db: float = 0.0, pitch_jitter: float = 0.04) -> void:
	if not enabled or not _streams.has(sound) or _waiting.has(sound):
		return
	var now := Time.get_ticks_msec() / 1000.0
	var start := maxf(now, _free_at)
	var delay := start - now
	if delay > MAX_LAG and not IMPORTANT.has(sound):
		return
	_free_at = start + GAP
	if delay > 0.001:
		_waiting[sound] = true
		get_tree().create_timer(delay).timeout.connect(_start.bind(sound, volume_db, pitch_jitter))
	else:
		_start(sound, volume_db, pitch_jitter)

func _start(sound: String, volume_db: float, pitch_jitter: float) -> void:
	_waiting.erase(sound)
	var player := _players[_next]
	_next = (_next + 1) % _players.size()
	player.stream = _streams[sound]
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	player.play()
