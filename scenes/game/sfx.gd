class_name Sfx
extends Node
## Sound effects (generated by tools/make_sfx.py) and the mixer. Sounds never
## start together: each one waits for a short gap after the previous, a sound
## already waiting is not queued twice, and minor sounds that would start too
## late are dropped.
##
## The mixer has a Music and an Effects bus under Master; their volumes are
## set from the menu and saved in user://settings.cfg.

const DIR := "res://assets/sfx/"
const NAMES: Array[String] = [
	"card_flip", "card_deal", "card_place", "coin", "bell", "reveal", "claim",
	"battle", "hook", "telescope", "pass", "click", "victory", "defeat", "burn",
]
## Cues that matter to the game; they are delayed but never dropped.
const IMPORTANT: Array[String] = ["bell", "reveal", "claim", "battle", "hook", "telescope", "victory", "defeat"]
const VOICES := 10
const GAP := 0.13
const MAX_LAG := 0.35
const SETTINGS := "user://settings.cfg"
## Mixer levels, 0..1, by bus name.
const DEFAULT_VOLUMES := {"Master": 0.8, "Music": 0.6, "Effects": 0.5}

var volumes := DEFAULT_VOLUMES.duplicate()

var _streams := {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _free_at := 0.0 # time (s) when the next sound may start
var _waiting := {} # sound name -> true while scheduled but not started
var _hush_until := 0.0

func _ready() -> void:
	_make_buses()
	var config := ConfigFile.new()
	if config.load(SETTINGS) == OK:
		for bus: String in volumes:
			volumes[bus] = clampf(config.get_value("audio", bus, volumes[bus]), 0.0, 1.0)
	for bus: String in volumes:
		set_volume(bus, volumes[bus])
	for sound in NAMES:
		_streams[sound] = load(DIR + sound + ".wav")
	for _i in range(VOICES):
		var player := AudioStreamPlayer.new()
		player.bus = "Effects"
		add_child(player)
		_players.append(player)

## Music and Effects buses under Master. Effects goes through a gentle
## compressor and a limiter, so loud moments do not jump out.
static func _make_buses() -> void:
	for bus in ["Music", "Effects"]:
		if AudioServer.get_bus_index(bus) >= 0:
			continue
		AudioServer.add_bus()
		var index := AudioServer.bus_count - 1
		AudioServer.set_bus_name(index, bus)
		AudioServer.set_bus_send(index, "Master")
	var effects := AudioServer.get_bus_index("Effects")
	if AudioServer.get_bus_effect_count(effects) == 0:
		var compressor := AudioEffectCompressor.new()
		compressor.threshold = -20.0
		compressor.ratio = 3.0
		compressor.attack_us = 3000.0
		compressor.release_ms = 180.0
		AudioServer.add_bus_effect(effects, compressor)
		var limiter := AudioEffectLimiter.new()
		limiter.ceiling_db = -4.0
		limiter.threshold_db = -6.0
		AudioServer.add_bus_effect(effects, limiter)

## Sets bus `bus` to `level` (0..1, 0 = muted).
func set_volume(bus: String, level: float) -> void:
	volumes[bus] = level
	var index := AudioServer.get_bus_index(bus)
	AudioServer.set_bus_volume_db(index, linear_to_db(maxf(level, 0.0001)))
	AudioServer.set_bus_mute(index, level <= 0.0)

func save_volumes() -> void:
	var config := ConfigFile.new()
	config.load(SETTINGS)
	for bus: String in volumes:
		config.set_value("audio", bus, volumes[bus])
	config.save(SETTINGS)

## No sounds at all for `seconds` (e.g. while a new game settles in).
func hush(seconds: float) -> void:
	_hush_until = Time.get_ticks_msec() / 1000.0 + seconds

## Plays `sound`; `volume_db` lowers it (e.g. for opponents' actions).
func play(sound: String, volume_db: float = 0.0, pitch_jitter: float = 0.04) -> void:
	if not _streams.has(sound) or _waiting.has(sound):
		return
	var now := Time.get_ticks_msec() / 1000.0
	if now < _hush_until:
		return
	var start := maxf(now, _free_at)
	var delay := start - now
	if delay > MAX_LAG and not IMPORTANT.has(sound):
		return
	_free_at = start + GAP
	if delay > 0.001:
		_waiting[sound] = true
		get_tree().create_timer(delay).timeout.connect(_start.bind(sound, volume_db, pitch_jitter))
	else:
		_start(sound, volume_db, pitch_jitter)

func _start(sound: String, volume_db: float, pitch_jitter: float) -> void:
	_waiting.erase(sound)
	var player := _players[_next]
	_next = (_next + 1) % _players.size()
	player.stream = _streams[sound]
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	player.play()
